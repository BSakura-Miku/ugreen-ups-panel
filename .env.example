# Pin a release tag or digest. Change deliberately when upgrading.
UPS_IMAGE=bsakuramiku/ugreen-ups-panel:0.3.1
# For LAN access, replace loopback with the NAS LAN address.
UPS_BIND_IP=127.0.0.1
UPS_PORT=9086
TZ=Asia/Shanghai
# The data directory must exist and be writable by UID/GID 10001.
UPS_DATA_DIR=./data
# Created by the host collector; mount read-only in the dashboard.
UPS_CAPTURE_DIR=/run/ugreen-ups-panel
